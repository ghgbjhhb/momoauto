YUNMOMO_TOKEN=
YUNMOMO_CERT_PATH=
# Select an explicit device from the current list; IDs and udid can change.
YUNMOMO_DEVICE_ID=
YUNMOMO_UDID=
# 改机重置：default CN / Android 16; model version must match the cloud phone OS.
YUNMOMO_COUNTRY_CODE=CN
YUNMOMO_ANDROID_VERSION=16
# Add VPC networks from a private text/JSON file; do not commit proxy credentials.
YUNMOMO_VPC_DATA_FILE=
YUNMOMO_VPC_GROUP_ID=
YUNMOMO_VPC_REMARKS=
# Select a saved VPC ID, or a successful single-network result file.
YUNMOMO_VPC_ID=
YUNMOMO_VPC_RESULT_PATH=
# Script timing: set these in the startup shell (before loading Node modules).
YUNMOMO_TIMING=1
YUNMOMO_TIMING_DIR=
